<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingVertical="8dp" android:paddingHorizontal="8dp"
    android:background="#FFFFFF" android:gravity="center_vertical">
    <CheckBox android:id="@+id/checked" android:layout_width="48dp" android:layout_height="48dp"
        android:contentDescription="@string/grocery_checked" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="#24231F" />
        <TextView android:id="@+id/row_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#77736C" />
    </LinearLayout>
    <TextView android:id="@+id/row_action" android:layout_width="48dp" android:layout_height="48dp"
        android:gravity="center" android:text="@string/grocery_menu" android:textSize="26sp" android:textColor="#4E8CDC" />
</LinearLayout>
