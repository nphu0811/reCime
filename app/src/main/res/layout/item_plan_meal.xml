<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="#FFFFFF" android:paddingHorizontal="12dp" android:paddingVertical="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/row_meta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#77736C" android:textSize="13sp" />
        <TextView android:id="@+id/row_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="32dp"
            android:gravity="center_vertical" android:textColor="#24231F" android:textSize="17sp" />
    </LinearLayout>
    <TextView android:id="@+id/plan_drag_handle" android:layout_width="48dp"
        android:layout_height="48dp" android:gravity="center" android:textSize="24sp"
        android:textColor="#4E8CDC" android:text="@string/planner_drag_symbol"
        android:contentDescription="@string/planner_drag" />
</LinearLayout>
