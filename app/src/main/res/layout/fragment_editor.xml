<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_glow"
    tools:context=".fragment.EditorFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your recipe.\nYour rules. ✦"
            android:fontFamily="sans-serif-black"
            android:textSize="34sp"
            android:textColor="@color/soft_white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kiểm tra tên, lượng và các bước trước khi lưu. Mỗi nguyên liệu/bước trên một dòng." />

        <EditText
            android:id="@+id/edit_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên món *"
            android:inputType="textCapSentences"
            tools:text="Gỏi cuốn tôm thịt" />

        <EditText
            android:id="@+id/edit_book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bộ sưu tập"
            android:inputType="textCapSentences"
            tools:text="Món nhà" />

        <EditText
            android:id="@+id/edit_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tags, cách nhau bởi dấu phẩy"
            android:inputType="text"
            tools:text="gỏi, cuốn, món Việt" />

        <EditText
            android:id="@+id/edit_servings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Khẩu phần gốc *"
            android:inputType="numberDecimal"
            tools:text="4" />

        <EditText
            android:id="@+id/edit_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nguyên liệu *"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="5"
            tools:text="4 cái bánh tráng&#10;50 g bún đã nấu chín&#10;Tôm và thịt đã chín theo nguồn" />

        <EditText
            android:id="@+id/edit_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Các bước *"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="4"
            tools:text="Chuẩn bị nguyên liệu.&#10;Cuốn bánh tráng và dùng cùng nước chấm." />

        <EditText
            android:id="@+id/edit_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nguồn / URL"
            android:inputType="text"
            tools:text="Wikibooks / công thức gia đình" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dinh dưỡng tùy chọn — mỗi khẩu phần gốc, tự nhập. Cần ghi nguồn; để trống nếu chưa đủ dữ liệu."
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/edit_kcal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Calories (kcal)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_protein"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Protein (g)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_carbs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Carb (g)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_fat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fat (g)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edit_nutrition_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nguồn dinh dưỡng / nhãn sản phẩm"
            android:inputType="text" />

        <TextView
            android:id="@+id/edit_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/electric_coral" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            android:textColor="@color/night_ink"
            app:backgroundTint="@color/acid_lime"
            app:cornerRadius="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE THE FLAVOUR ↗" />

    </LinearLayout>

</ScrollView>
