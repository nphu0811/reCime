<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FAF8F2" android:theme="@style/Theme.RecipeEditor" tools:context=".fragment.EditorFragment">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:paddingHorizontal="12dp" android:gravity="center_vertical" android:background="#FFFFFF">
        <com.google.android.material.button.MaterialButton android:id="@+id/back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Cancel" android:textColor="#24231F" android:textSize="18sp" android:textAllCaps="false"/>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/save" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Save" android:textColor="#326DB9" android:textSize="18sp" android:textAllCaps="false"/>
    </LinearLayout>
    <TextView android:id="@+id/edit_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:textColor="#B3261E" android:accessibilityLiveRegion="polite"/>
    <ScrollView android:id="@+id/editor_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="#FFFFFF">
            <EditText android:id="@+id/edit_title" style="@style/EditorField" android:hint="Title" android:inputType="textCapSentences" android:textSize="28sp" android:fontFamily="serif" android:background="@android:color/transparent"/>
            <TextView style="@style/EditorSection" android:text="Images"/>
            <TextView android:id="@+id/photo_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 / 5" android:textColor="#77736C" android:accessibilityLiveRegion="polite"/>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top">
                    <LinearLayout android:id="@+id/editor_photos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="12dp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/add_editor_photos" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="132dp" android:layout_height="180dp" android:text="@string/editor_add_photo" android:textAllCaps="false" android:textColor="#24231F" app:strokeColor="#DED9CF" app:cornerRadius="18dp" android:layout_marginVertical="12dp"/>
                </LinearLayout>
            </HorizontalScrollView>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="#EEEAE2"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/info_toggle" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="start|center_vertical" android:text="Info  ›" android:textSize="18sp" android:textColor="#24231F" android:textAllCaps="false"/>
            <LinearLayout android:id="@+id/info_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <EditText android:id="@+id/edit_servings" style="@style/EditorField" android:hint="Khẩu phần gốc *" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/edit_book" style="@style/EditorField" android:hint="Bộ sưu tập" android:inputType="textCapSentences"/>
                <EditText android:id="@+id/edit_source" style="@style/EditorField" android:hint="Nguồn / URL" android:inputType="textUri"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="#EEEAE2"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/nutrition_toggle" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="start|center_vertical" android:text="Nutrition  ›" android:textSize="18sp" android:textColor="#24231F" android:textAllCaps="false"/>
            <LinearLayout android:id="@+id/nutrition_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mỗi khẩu phần gốc. Để trống nếu chưa có dữ liệu; ghi nguồn khi nhập giá trị." android:textColor="#77736C"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/estimate_nutrition" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ước tính USDA · cần xác nhận" android:textAllCaps="false"/>
                <EditText android:id="@+id/edit_kcal" style="@style/EditorField" android:hint="Calories (kcal)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/edit_protein" style="@style/EditorField" android:hint="Protein (g)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/edit_carbs" style="@style/EditorField" android:hint="Carbs (g)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/edit_fat" style="@style/EditorField" android:hint="Fat (g)" android:inputType="numberDecimal"/>
                <EditText android:id="@+id/edit_nutrition_source" style="@style/EditorField" android:hint="Nguồn dinh dưỡng / nhãn sản phẩm" android:inputType="textCapSentences"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="#EEEAE2"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/tags_toggle" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="start|center_vertical" android:text="Tags  ›" android:textSize="18sp" android:textColor="#24231F" android:textAllCaps="false"/>
            <LinearLayout android:id="@+id/tags_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <EditText android:id="@+id/edit_tags" style="@style/EditorField" android:hint="Tags, cách nhau bởi dấu phẩy" android:inputType="text"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="#EEEAE2"/>
            <TextView style="@style/EditorSection" android:text="Ingredients"/>
            <EditText android:id="@+id/edit_ingredients" style="@style/EditorField" android:hint="Add ingredient or heading" android:inputType="textMultiLine" android:gravity="top" android:minLines="3"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="#EEEAE2"/>
            <TextView style="@style/EditorSection" android:text="Instructions"/>
            <EditText android:id="@+id/edit_steps" style="@style/EditorField" android:hint="Add step or heading" android:inputType="textMultiLine" android:gravity="top" android:minLines="3"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mỗi nguyên liệu hoặc bước trên một dòng." android:textColor="#77736C" android:paddingTop="12dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
