<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="24dp"
    tools:context=".fragment.RecipesFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/eyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="reCime / YOUR FOOD ERA ✦"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textColor="@color/acid_lime"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ăn ngon.\nSống chất."
                android:fontFamily="sans-serif-black"
                android:textSize="34sp"
                android:textColor="@color/soft_white" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ai_camera"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="✦ AI SCAN"
            android:textSize="12sp"
            android:textColor="@color/night_ink"
            app:backgroundTint="@color/acid_lime"
            android:contentDescription="Nhập ảnh món ăn bằng AI"
            app:cornerRadius="24dp" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxBackgroundColor="@color/card_ink"
        app:boxStrokeColor="@color/acid_lime"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingVertical="8dp"
            android:hint="Search một món, cook một vibe ✦"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ingredient_filter"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:hint="Nguyên liệu có sẵn (cách nhau bởi dấu phẩy)"
            android:inputType="text" android:singleLine="true" android:textSize="13sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/category_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.Chip.Filter"
                android:text="Tất cả"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_soup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.Chip.Filter"
                android:text="Món nước" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.Chip.Filter"
                android:text="Món mặn" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_vegan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.Chip.Filter"
                android:text="Ăn chay" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sweet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.Chip.Filter"
                android:text="Bánh &amp; chè" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hero_card"
        android:layout_width="match_parent"
        android:layout_height="182dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="9dp"
        app:strokeWidth="0dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/hero_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/food_art"
                android:contentDescription="Món ăn nổi bật trong thư viện"
                tools:src="@drawable/preview_bun_bo_hue" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/hero_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦ TONIGHT’S PICK · OPEN RECIPE"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:textColor="@color/acid_lime" />

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ăn gì hôm nay?"
                    android:textSize="29sp"
                    android:fontFamily="serif"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/hero_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TAP TO GET COOKING →"
                    android:textSize="11sp"
                    android:textColor="#F8F5EC" />

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <Spinner
            android:id="@+id/books"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Bộ sưu tập" />

        <CheckBox
            android:id="@+id/favorites"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="♡ SAVED"
            android:contentDescription="Chỉ món yêu thích" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="+ TẠO MÓN"
            style="@style/Widget.Material3.Button.TextButton"
            android:textSize="12sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/manage_books"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="▦ Quản lý cookbooks · tạo / đổi tên / xóa"
        android:textAllCaps="false"
        android:textSize="12sp"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="Đang nạp công thức ✦"
        android:textSize="11sp"
        android:textColor="@color/muted_ink" />

    <GridView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="2"
        android:horizontalSpacing="8dp"
        android:verticalSpacing="12dp"
        android:stretchMode="columnWidth"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        tools:listitem="@layout/item_recipe"
        tools:itemCount="4" />

</LinearLayout>
