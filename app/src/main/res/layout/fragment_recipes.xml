<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#FAF8F2">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Recipes" android:maxLines="2" android:ellipsize="end" android:textSize="28sp" android:textStyle="bold" android:textColor="#24231F"/>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/open_settings" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginEnd="8dp" android:padding="12dp" android:src="@drawable/ic_settings_outline" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Cài đặt và tài khoản"/>
        <Button android:id="@+id/add" android:layout_width="56dp" android:layout_height="52dp" android:text="+" android:textSize="24sp" android:contentDescription="Thêm công thức"/>
    </LinearLayout>
    <TextView android:id="@+id/catalog_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Catalog offline · Nguồn ghi trong từng công thức" android:textColor="#69655E" android:visibility="gone"/>
    <Button android:id="@+id/remote_discover" android:layout_width="match_parent" android:layout_height="48dp" android:text="Tìm catalog trên backend riêng" android:visibility="gone"/>
    <EditText android:id="@+id/search" style="@style/EditorField" android:hint="Tìm công thức" android:singleLine="true" android:imeOptions="actionDone"/>
    <LinearLayout android:id="@+id/library_sections" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/manage_books" style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="@color/library_section" android:textColor="#24231F" android:layout_marginEnd="4dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Cookbooks"/>
        <Button android:id="@id/all_recipes" style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="@color/library_section" android:textColor="#24231F" android:layout_marginEnd="4dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="All Recipes"/>
        <Button android:id="@+id/new_book" android:layout_width="52dp" android:layout_height="48dp" android:text="+" android:contentDescription="Tạo cookbook"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/recipe_filters" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <EditText android:id="@+id/ingredient_filter" style="@style/EditorField" android:hint="Lọc nguyên liệu (cách nhau bởi dấu phẩy)" android:singleLine="true" android:textSize="13sp"/>
        <CheckBox android:id="@+id/favorites" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Yêu thích" android:textColor="#24231F"/>
    </LinearLayout>
    <Button android:id="@id/cookbook_options" android:layout_width="match_parent" android:layout_height="48dp" android:text="Tùy chọn cookbook" android:visibility="gone"/>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:textColor="#69655E"/>
    <GridView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:numColumns="2" android:horizontalSpacing="8dp" android:verticalSpacing="12dp" android:clipToPadding="false" android:paddingBottom="12dp"/>
</LinearLayout>
