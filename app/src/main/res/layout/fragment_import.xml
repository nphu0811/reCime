<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Từ ý tưởng tới bữa ăn"
            android:fontFamily="serif"
            android:textSize="30sp"
            android:textColor="#173F33" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nhập nội dung bạn có quyền sử dụng. Luôn kiểm tra kết quả OCR và định lượng trước khi lưu."
            android:layout_marginVertical="16dp" />

        <Button
            android:id="@+id/manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Viết công thức mới" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/pick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Chọn ảnh"
                android:layout_weight="1" />

            <Button
                android:id="@+id/camera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Chụp ảnh"
                android:layout_weight="1" />

        </LinearLayout>

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="https://… trang công thức công khai"
            android:inputType="textUri"
            android:singleLine="true" />

        <Button
            android:id="@+id/fetch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đọc Recipe JSON-LD từ URL" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Social video, speech và LLM: chưa hỗ trợ. Dán caption hoặc dùng screenshot. URL chỉ hỗ trợ Recipe JSON-LD công khai."
            android:layout_marginVertical="12dp" />

        <EditText
            android:id="@+id/raw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Tên món Nguyên liệu 200 g đậu phụ 1 muỗng canh dầu Cách làm Áp chảo đậu."
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="8" />

        <Button
            android:id="@+id/review"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phân tích → kiểm tra &amp; sửa" />

    </LinearLayout>

</ScrollView>
