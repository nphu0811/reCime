<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".fragment.ImportFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="reCime / THE AI KITCHEN ✦"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:textColor="@color/acid_lime" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="See it.\nCook it."
                android:fontFamily="sans-serif-black"
                android:textSize="36sp"
                android:textColor="@color/night_ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_settings"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="⚙ AI SETUP"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TextButton" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="@color/acid_lime"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✦ SNAP. MATCH. COOK."
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/night_ink" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Biến ảnh món ăn thành cảm hứng nấu nướng. AI gợi ý, bạn chọn công thức phù hợp."
                    android:textSize="13sp"
                    android:textColor="@color/night_ink" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ai_pick"
                    android:textColor="@color/soft_white"
                    app:backgroundTint="@color/night_ink"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="✦ SCAN MÓN ĂN"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pick"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📷 SCAN CHỮ"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/camera"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="✦ CAMERA"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="14dp" />

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/acid_lime"
            app:boxBackgroundColor="@color/card_ink">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/url"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Link TikTok hoặc trang công thức"
                android:inputType="textUri"
                android:singleLine="true"
                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fetch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="PASTE & IMPORT ↗"
            app:cornerRadius="14dp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:text="Ảnh có chữ dùng OCR trên điện thoại. TikTok đọc caption công khai khi nền tảng cho phép. Luôn kiểm tra kết quả trước khi lưu."
            android:textSize="12sp"
            android:textColor="@color/muted_ink" />

        <EditText
            android:id="@+id/raw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="5"
            android:gravity="top"
            android:hint="Dán caption, ghi chú hoặc sửa chữ vừa nhận từ ảnh…"
            android:inputType="textMultiLine|textCapSentences"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ai_text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="✦ AI MATCH TỪ CAPTION"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/review"
            android:textColor="@color/night_ink"
            app:backgroundTint="@color/electric_coral"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="LET’S COOK → Review &amp; save"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/manual"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="+ TỰ VIẾT CÔNG THỨC"
            style="@style/Widget.Material3.Button.TextButton" />

    </LinearLayout>

</ScrollView>
