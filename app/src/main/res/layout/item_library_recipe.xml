<?xml version="1.0" ?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="3dp" android:clickable="false" android:focusable="false" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeColor="#E6E1D8" app:strokeWidth="1dp" app:cardBackgroundColor="#FFFFFF">
