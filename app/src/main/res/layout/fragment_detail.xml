<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.DetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ Công thức" />

        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:src="@drawable/food_art"
            android:scaleType="centerCrop"
            android:contentDescription="Ảnh món ăn"
            tools:src="@drawable/preview_bun_bo_hue" />

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:fontFamily="serif"
            android:textColor="#123B2D"
            tools:text="Bún bò Huế" />

        <TextView
            android:id="@+id/detail_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            tools:text="Món nước · Wikibooks" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/favorite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Yêu thích"
                android:layout_weight="1" />

            <Button
                android:id="@+id/edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Sửa"
                android:layout_weight="1" />

            <Button
                android:id="@+id/delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Xóa"
                android:layout_weight="1" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nguyên liệu"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/minus"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="−" />

            <TextView
                android:id="@+id/portions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_weight="1"
                tools:text="1 mẻ công thức" />

            <Button
                android:id="@+id/plus"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="+" />

        </LinearLayout>

        <CheckBox
            android:id="@+id/metric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đổi sang g / ml" />

        <Button
            android:id="@+id/unit_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chuẩn thìa &amp; cup" />

        <TextView
            android:id="@+id/detail_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:lineSpacingExtra="8dp"
            tools:text="• Bún và thịt theo công thức nguồn&#10;• Sả, gia vị và rau ăn kèm" />

        <Button
            android:id="@+id/to_grocery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thêm nguyên liệu vào giỏ" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cách làm"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/detail_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:lineSpacingExtra="8dp"
            tools:text="1. Sơ chế nguyên liệu theo hướng dẫn.&#10;&#10;2. Nấu nước dùng và hoàn thiện món." />

        <TextView
            android:id="@+id/nutrition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="20dp"
            tools:text="Dinh dưỡng: chưa đủ dữ liệu" />

        <TextView
            android:id="@+id/source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
        android:autoLink="web"
            tools:text="Wikibooks · CC BY-SA 4.0&#10;Tác giả và giấy phép ảnh có trong chi tiết nguồn." />

    </LinearLayout>

</ScrollView>
