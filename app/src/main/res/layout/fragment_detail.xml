<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_glow"
    tools:context=".fragment.DetailFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK TO KITCHEN" />

        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="252dp"
            android:src="@drawable/food_art"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_editorial_pill"
            android:clipToOutline="true"
            android:contentDescription="Ảnh món ăn"
            tools:src="@drawable/preview_bun_bo_hue" />

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/soft_white"
            tools:text="Bún bò Huế" />

        <TextView
            android:id="@+id/detail_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            tools:text="Món nước · Wikibooks" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/favorite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Yêu thích"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Sửa"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/delete"
                android:textColor="@color/electric_coral"
                app:backgroundTint="@color/card_ink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Xóa"
                android:layout_weight="1" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✦ IN THE MIX"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/minus"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="−" />

            <TextView
                android:id="@+id/portions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_weight="1"
                tools:text="1 mẻ công thức" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/plus"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="+" />

        </LinearLayout>

        <CheckBox
            android:id="@+id/metric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đổi sang g / ml" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/unit_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cài đặt đơn vị đo ⚙" />

        <TextView
            android:id="@+id/detail_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:lineSpacingExtra="8dp"
            tools:text="• Bún và thịt theo công thức nguồn&#10;• Sả, gia vị và rau ăn kèm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/to_grocery"
            android:textColor="@color/night_ink"
            app:backgroundTint="@color/acid_lime"
            app:cornerRadius="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ ADD TO CART ↗" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_to_book"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="▦ Quản lý cookbooks" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/to_plan"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="+ Thêm vào lịch ăn" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cooking_mode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶ BẮT ĐẦU NẤU · TỪNG BƯỚC"
            android:textColor="@color/night_ink"
            app:backgroundTint="@color/electric_coral" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/ask_recipe_ai"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="✦ Hỏi AI về cách nấu (cần API key)" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/export_pdf" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:text="↓ Xuất PDF"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/print_recipe" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:text="In công thức"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✦ LET’S COOK"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/detail_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:lineSpacingExtra="8dp"
            tools:text="1. Sơ chế nguyên liệu theo hướng dẫn.&#10;&#10;2. Nấu nước dùng và hoàn thiện món." />

        <TextView
            android:id="@+id/nutrition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="20dp"
            tools:text="Dinh dưỡng: chưa đủ dữ liệu" />

        <TextView
            android:id="@+id/source"
            android:textColor="@color/muted_ink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
        android:autoLink="web"
            tools:text="Wikibooks · CC BY-SA 4.0&#10;Tác giả và giấy phép ảnh có trong chi tiết nguồn." />

    </LinearLayout>

</ScrollView>
