<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp">
    <DatePicker android:id="@+id/plan_move_date" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:datePickerMode="spinner"
        android:calendarViewShown="false" />
    <Spinner android:id="@+id/plan_move_type" android:layout_width="match_parent"
        android:layout_height="48dp" android:spinnerMode="dropdown" />
    <TextView android:id="@+id/plan_servings_hint" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/planner_servings_hint" />
    <EditText android:id="@+id/plan_item_servings" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp"
        android:hint="@string/planner_servings" android:inputType="numberDecimal" />
</LinearLayout>
