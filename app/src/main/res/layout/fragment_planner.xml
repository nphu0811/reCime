<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#FAF8F2">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView android:id="@+id/board_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="@string/planner_title"
            android:textSize="30sp" android:fontFamily="serif" android:textColor="#24231F" />
        <Button android:id="@+id/plan_week_start" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="@string/planner_week_start" />
    </LinearLayout>
    <TextView android:id="@+id/board_subtitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#77736C" />
    <LinearLayout android:id="@+id/week_controls" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical">
        <Button android:id="@+id/prev_week" android:layout_width="56dp" android:layout_height="48dp"
            android:text="@string/planner_previous_symbol" android:contentDescription="@string/planner_previous" />
        <TextView android:id="@+id/week_label" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:gravity="center" android:textColor="#24231F" />
        <Button android:id="@+id/next_week" android:layout_width="56dp" android:layout_height="48dp"
            android:text="@string/planner_next_symbol" android:contentDescription="@string/planner_next" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/board_secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" />
        <Button android:id="@+id/board_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" />
    </LinearLayout>
    <TextView android:id="@+id/board_empty" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingVertical="8dp" android:textColor="#77736C"
        android:textSize="12sp" android:accessibilityLiveRegion="polite" />
    <Spinner android:id="@+id/grocery_sort" android:layout_width="match_parent" android:layout_height="48dp" android:visibility="gone" />
    <ListView android:id="@+id/board_list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="4dp"
        android:clipToPadding="false" android:paddingBottom="12dp" />
</LinearLayout>
