<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="#FAF8F2">
    <TextView android:id="@+id/board_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="serif" android:textSize="30sp" android:textColor="#24231F" />
    <TextView android:id="@+id/board_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#77736C" />
    <LinearLayout android:id="@+id/week_controls" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone">
        <View android:id="@+id/prev_week" android:layout_width="0dp" android:layout_height="0dp" />
        <View android:id="@+id/next_week" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>
    <Button android:id="@+id/grocery_batch" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/grocery_batch" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/board_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" />
        <Button android:id="@+id/board_secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" />
    </LinearLayout>
    <Spinner android:id="@+id/grocery_sort" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/grocery_sort" android:spinnerMode="dropdown" />
    <TextView android:id="@+id/board_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:textColor="#77736C" android:accessibilityLiveRegion="polite" />
    <ListView android:id="@+id/board_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:divider="@android:color/transparent" android:dividerHeight="4dp" android:paddingBottom="12dp" android:clipToPadding="false" />
</LinearLayout>
