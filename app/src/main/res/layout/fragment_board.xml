<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/bg_screen_glow"
    tools:context=".fragment.BoardFragment">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PLAN IT. EAT IT. REPEAT ↗"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textSize="10sp"
        android:textColor="@color/acid_lime" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="@color/acid_lime"
        app:cardElevation="7dp"
        app:strokeWidth="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:id="@+id/board_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textSize="30sp"
                android:textColor="@color/night_ink"
                tools:text="Tuần này ăn gì?" />
            <TextView
                android:id="@+id/board_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textSize="13sp"
                android:textColor="@color/night_ink"
                tools:text="Sắp xếp bữa ngon theo cách của bạn." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/week_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prev_week"
            android:layout_width="54dp"
            android:layout_height="48dp"
            android:text="‹"
            android:textSize="22sp"
            android:textColor="@color/soft_white"
            app:backgroundTint="@color/dock_surface"
            app:cornerRadius="18dp" />

        <TextView
            android:id="@+id/week_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/soft_white"
            android:textStyle="bold"
            android:textSize="13sp"
            tools:text="20/10 — 26/10" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next_week"
            android:layout_width="54dp"
            android:layout_height="48dp"
            android:text="›"
            android:textSize="22sp"
            android:textColor="@color/soft_white"
            app:backgroundTint="@color/dock_surface"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/board_action"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:textColor="@color/night_ink"
        app:backgroundTint="@color/electric_coral"
        app:cornerRadius="20dp"
        tools:text="✦ Tạo danh sách đi chợ" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/board_secondary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/acid_lime"
        style="@style/Widget.Material3.Button.TextButton"
        tools:text="Hôm nay / tuần hiện tại" />

    <TextView
        android:id="@+id/board_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10dp"
        android:textSize="12sp"
        android:textColor="@color/muted_ink"
        tools:text="Thêm bữa ăn để tạo kế hoạch." />

    <ListView
        android:id="@+id/board_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:clipToPadding="false"
        android:paddingBottom="10dp"
        tools:listitem="@layout/item_board"
        tools:itemCount="4" />
</LinearLayout>
