<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".fragment.BoardFragment">

    <TextView
        android:id="@+id/board_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:fontFamily="serif"
        android:textColor="#123B2D"
        tools:text="Một tuần ngon lành" />

    <TextView
        android:id="@+id/board_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="12dp"
        tools:text="Chọn từng bữa để thêm hoặc thay món." />

    <LinearLayout
        android:id="@+id/week_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/prev_week"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:text="‹" />

        <TextView
            android:id="@+id/week_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_weight="1"
            tools:text="2026-10-20 - 2026-10-27" />

        <Button
            android:id="@+id/next_week"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:text="›" />

    </LinearLayout>

    <Button
        android:id="@+id/board_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Tạo giỏ từ tuần này" />

    <Button
        android:id="@+id/board_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Hôm nay / tuần hiện tại" />

    <TextView
        android:id="@+id/board_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Danh sách trống" />

    <ListView
        android:id="@+id/board_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        tools:listitem="@layout/item_board"
        tools:itemCount="4" />

</LinearLayout>
