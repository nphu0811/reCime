<resources>
    <style name="Theme.RecipeEditor" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#4E8CDC</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#24231F</item>
        <item name="colorOnSurfaceVariant">#77736C</item>
        <item name="android:colorBackground">#FAF8F2</item>
        <item name="android:textColor">#24231F</item>
        <item name="android:textColorHint">#8B877F</item>
        <item name="android:colorAccent">#4E8CDC</item>
    </style>
    <style name="EditorField" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">#24231F</item>
        <item name="android:textColorHint">#8B877F</item>
        <item name="android:textSize">17sp</item>
        <item name="android:backgroundTint">#DED9CF</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="EditorSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#24231F</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
</resources>
