# Copy to backend/.env. Never commit the populated file.
# Loaded on server startup; process environment takes precedence.
APP_ENV=development
DATABASE_URL=sqlite:///backend/data/recime.db
ALLOW_REGISTRATION=true

# Optional OpenAI: recipe Q&A, grounded text and recipe-page image extraction. Server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional USDA FoodData Central nutrition estimates.
FDC_API_KEY=

# Email/password uses revocable opaque sessions, not JWTs; no JWT_SECRET needed.
# Google OAuth, SMTP and YouTube APIs are not implemented; do not add unused keys.

# Cooking AI: local artifacts only; no implicit external fallback.
COOKING_AI_ADAPTER=cooking_ai/runs/production
COOKING_AI_JOBS_DIR=backend/data/cooking_jobs
COOKING_AI_JOB_TIMEOUT=300
# Optional local faster-whisper CTranslate2 model directory; blank disables ASR.
COOKING_AI_ASR_MODEL=
