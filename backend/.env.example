# Copy to backend/.env. Never commit the populated file.
# Loaded on server startup; process environment takes precedence.
APP_ENV=development
DATABASE_URL=sqlite:///backend/data/recime.db
ALLOW_REGISTRATION=true

# Optional OpenAI: recipe Q&A and grounded text extraction. Server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional USDA FoodData Central nutrition estimates.
FDC_API_KEY=

# Email/password uses revocable opaque sessions, not JWTs; no JWT_SECRET needed.
# Google OAuth, SMTP and YouTube APIs are not implemented; do not add unused keys.
